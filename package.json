{
  "name": "loodi-one",
  "version": "0.1.0",
  "private": true,
  "description": "Shell Capacitor pour l'écosystème Loodi — conteneur unifié de modules PWA",
  "workspaces": [
    "apps/*",
    "packages/@loodi/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @loodi/one",
    "dev:dummy": "npm run dev -w @loodi/dummy",
    "build": "npm run build:packages && npm run build -w @loodi/one",
    "build:local": "npm run build:local -w @loodi/one",
    "build:android-emulator": "npm run build:android-emulator -w @loodi/one",
    "build:android-device": "npm run build:android-device -w @loodi/one",
    "build:ios-simulator": "npm run build:ios-simulator -w @loodi/one",
    "build:ios-device": "npm run build:ios-device -w @loodi/one",
    "build:recette": "npm run build:recette -w @loodi/one",
    "test:run": "npm run test:run -w @loodi/one",
    "build:packages": "npm run build -w @loodi/bridge && npm run build -w @loodi/auth && npm run build -w @loodi/ui",
    "cap:sync:android-emulator": "npm run build:android-emulator && npx cap sync android",
    "cap:sync:android-device": "node apps/one/scripts/sync-device.mjs android",
    "cap:sync:ios-simulator": "npm run build:ios-simulator && npx cap sync ios",
    "cap:sync:ios-device": "node apps/one/scripts/sync-device.mjs ios",
    "watch:packages": "npm run watch -w @loodi/bridge & npm run watch -w @loodi/ui",
    "build:packages:watch": "npm run watch:packages",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "puppeteer@25.3.0": true
  }
}
