{
  "color": {
    "brand-primary": "#ca4a16",
    "brand-primary-hover": "#b33d0f",
    "brand-link": "#1b2a4a",
    "bg-light": "#f1f1ef",
    "bg-dark": "#1a1a18",
    "text-light": "#353533",
    "text-dark": "#e8e7e4",
    "text-primary": "#1A1A18",
    "text-primary-dark": "{color.text-dark}",
    "text-secondary": "#6B6B60",
    "text-secondary-dark": "#A3A39A",
    "surface-glass": "rgba(255,255,255,0.7)",
    "surface-glass-dark": "rgba(17,24,39,0.7)",
    "surface-subtle": "#F2F0EC",
    "surface-subtle-dark": "#3A3A35",
    "border-subtle": "rgba(0,0,0,0.05)",
    "border-subtle-dark": "rgba(255,255,255,0.1)",
    "settings-bg": "#f5f5f0",
    "settings-bg-dark": "#161615",
    "module-loodi": "#ca4a16",
    "module-mate": "#2e8b57",
    "module-mag": "#4a90d9",
    "module-places": "#9b59b6",
    "module-fest": "#e67e22",
    "module-sessions": "#1abc9c",
    "module-dev": "#6b7280"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px"
  },
  "radius": {
    "pill": "9999px",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.25rem"
  },
  "font": {
    "brand": ["DM Sans", "Inter", "system-ui", "sans-serif"],
    "display": ["Playfair Display", "Georgia", "serif"],
    "mono": ["JetBrains Mono", "monospace"]
  },
  "typography": {
    "display": {
      "fontFamily": "display",
      "fontSize": "clamp(1.25rem, 4vw, 1.75rem)",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "body": {
      "fontFamily": "brand",
      "fontSize": "0.9375rem",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "brand",
      "fontSize": "0.75rem",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "0.05em",
      "textTransform": "uppercase"
    },
    "caption": {
      "fontFamily": "brand",
      "fontSize": "0.6875rem",
      "fontWeight": 500,
      "lineHeight": 1.2
    },
    "mono": {
      "fontFamily": "mono",
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "shadow": {
    "ambient-low": {
      "offsetX": "0",
      "offsetY": "1px",
      "blur": "2px",
      "spread": "0",
      "color": "rgba(0,0,0,0.05)"
    },
    "ambient-mid": {
      "offsetX": "0",
      "offsetY": "10px",
      "blur": "15px",
      "spread": "-3px",
      "color": "rgba(0,0,0,0.05)"
    },
    "elevated": {
      "offsetX": "0",
      "offsetY": "20px",
      "blur": "25px",
      "spread": "-5px",
      "color": "rgba(0,0,0,0.05)"
    }
  }
}
