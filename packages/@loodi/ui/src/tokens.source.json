  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px"
  },
  "radius": {
    "pill": "9999px",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.25rem"
  },
  "font": {
    "brand": ["DM Sans", "Inter", "system-ui", "sans-serif"],
    "display": ["Playfair Display", "Georgia", "serif"],
    "mono": ["JetBrains Mono", "monospace"]
  },
  "typography": {
    "display": {
      "fontFamily": "display",
      "fontSize": "clamp(1.25rem, 4vw, 1.75rem)",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "body": {
      "fontFamily": "brand",
      "fontSize": "0.9375rem",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "brand",
      "fontSize": "0.75rem",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "0.05em",
      "textTransform": "uppercase"
    },
    "caption": {
      "fontFamily": "brand",
      "fontSize": "0.6875rem",
      "fontWeight": 500,
      "lineHeight": 1.2
    },
    "mono": {
      "fontFamily": "mono",
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "shadow": {
    "ambient-low": {
      "offsetX": "0",
      "offsetY": "1px",
      "blur": "2px",
      "spread": "0",
      "color": "rgba(0,0,0,0.05)"
    },
    "ambient-mid": {
      "offsetX": "0",
      "offsetY": "10px",
      "blur": "15px",
      "spread": "-3px",
      "color": "rgba(0,0,0,0.05)"
    },
    "elevated": {
      "offsetX": "0",
      "offsetY": "20px",
      "blur": "25px",
      "spread": "-5px",
      "color": "rgba(0,0,0,0.05)"
    },
    "emphasis": {
      "offsetX": "0",
      "offsetY": "0",
      "blur": "25px",
      "spread": "0",
      "color": "rgba(0,0,0,0.25)"
    }
  }
}
