  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "20px"
    }
  },
  "radius": {
    "pill": {
      "$type": "dimension",
      "$value": "9999px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "1.25rem"
    }
  },
  "font": {
    "brand": {
      "$type": "fontFamily",
      "$value": [
        "DM Sans",
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Playfair Display",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "JetBrains Mono",
        "monospace"
      ]
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "clamp(1.25rem, 4vw, 1.75rem)",
        "fontWeight": 400,
        "lineHeight": 1.2
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.brand}",
        "fontSize": "0.9375rem",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.brand}",
        "fontSize": "0.75rem",
        "fontWeight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "0.05em",
        "textTransform": "uppercase"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.brand}",
        "fontSize": "0.6875rem",
        "fontWeight": 500,
        "lineHeight": 1.2
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "0.875rem",
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    }
  },
  "shadow": {
    "ambient-low": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0",
        "color": "rgba(0,0,0,0.05)"
      }
    },
    "ambient-mid": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "10px",
        "blur": "15px",
        "spread": "-3px",
        "color": "rgba(0,0,0,0.05)"
      }
    },
    "elevated": {
      "$type": "shadow",
      "$value": {
        "offsetX": "0",
        "offsetY": "20px",
        "blur": "25px",
        "spread": "-5px",
        "color": "rgba(0,0,0,0.05)"
      }
    }
  }
}
